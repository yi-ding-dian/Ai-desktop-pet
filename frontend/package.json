{
  "name": "ai-desktop-pet",
  "version": "0.1.0",
  "description": "AI 桌面宠物 - Electron 前端",
  "desktopName": "ai-desktop-pet",
  "homepage": "https://github.com/yicaibao/ai-desktop-pet",
  "main": "out/main/main.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test:hit-gate": "esbuild electron/window/hit-gate.test.ts --bundle --platform=node --format=esm --outfile=out/tests/hit-gate.test.mjs && esbuild electron/window/xdotool-cursor-source.test.ts --bundle --platform=node --format=esm --outfile=out/tests/xdotool-cursor-source.test.mjs && node out/tests/hit-gate.test.mjs && node out/tests/xdotool-cursor-source.test.mjs",
    "test:bubble-geometry": "esbuild electron/bubble/geometry.test.ts --bundle --platform=node --format=esm --outfile=out/tests/bubble-geometry.test.mjs && node out/tests/bubble-geometry.test.mjs",
    "test:teaching-geometry": "esbuild electron/teaching/geometry.test.ts --bundle --platform=node --format=esm --outfile=out/tests/teaching-geometry.test.mjs && node out/tests/teaching-geometry.test.mjs",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:linux-deb": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win-nsis": "npm run build && electron-builder --win nsis",
    "dist:win-portable": "npm run build && electron-builder --win portable"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  }
}
